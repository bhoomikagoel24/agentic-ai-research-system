# ─────────────────────────────────────────────
# STAGE 1: dependency builder
# Separate layer so re-installs don't happen on
# every code change — only on requirements change.
# ─────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# System deps needed at build time only (some packages compile C extensions)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# ─────────────────────────────────────────────
# STAGE 2: runtime image
# Lean image — no build tools, no apt cache.
# ─────────────────────────────────────────────
FROM python:3.11-slim AS runtime

# Non-root user — good security practice, required by some cloud platforms
RUN useradd --create-home --shell /bin/bash aria
WORKDIR /home/aria/app

# Copy pre-installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source
COPY --chown=aria:aria . .

# Switch to non-root
USER aria

# Environment defaults (override with --env-file or -e in docker run / compose)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000

EXPOSE 8000

# Liveness probe — Docker will restart the container if /health stops responding.
# --start-period gives the app time to load models before health is checked.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Uvicorn runs the FastAPI app.
# --workers 1 because the pipeline holds significant in-process state (ChromaDB,
# MemorySaver checkpoint). Multiple workers would create isolated state per worker.
# For horizontal scaling, run multiple containers instead (each with their own state),
# or move state to a shared DB (Redis/Postgres) — that's the next infra step.
CMD ["python", "-m", "uvicorn", "api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "1", \
     "--log-level", "info"]
